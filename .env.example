# Example environment file for safeway-coupons with Docker Compose.
#
# Copy this file to `.env` in the same directory as the compose file, then
# replace the placeholder values with your own. Docker Compose loads `.env`
# automatically, and the values are passed through by docker-compose.yaml and
# docker-compose.dev.yaml.
#
# `.env` is listed in .gitignore and must never be committed.
#
# If a value contains spaces, `#`, `$`, or quotes, wrap it in single quotes so
# Docker Compose treats it literally.

# ---------------------------------------------------------------------------
# Safeway account (required unless SAFEWAY_ACCOUNTS_FILE is used)
# ---------------------------------------------------------------------------
SAFEWAY_ACCOUNT_USERNAME=your.safeway.account.email@example.com
SAFEWAY_ACCOUNT_PASSWORD=your_password

# Email summary settings (optional; omit or leave blank to disable sending)
SAFEWAY_ACCOUNT_MAIL_FROM=your.email@example.com
SAFEWAY_ACCOUNT_MAIL_TO=your.email@example.com

# ---------------------------------------------------------------------------
# Container / cron settings
# ---------------------------------------------------------------------------
CRON_SCHEDULE="0 2 * * *"

# Optional time zone for the cron schedule (default: UTC)
# TZ=America/Phoenix

# Optional SMTP host used for email delivery
# SMTPHOST=your.smtp.host

# Optional path to an accounts file inside the container. When set, this takes
# the place of the SAFEWAY_ACCOUNT_* environment variables.
# SAFEWAY_ACCOUNTS_FILE=/accounts_file

# ---------------------------------------------------------------------------
# Cookie-based authentication (optional)
# ---------------------------------------------------------------------------
# Set BOTH variables to skip browser login and use an existing Safeway session
# directly. This is useful for one-off headless runs, but the session access
# token expires about 45 minutes after it is issued. If either value is
# malformed, truncated, or expired, safeway-coupons warns and falls back to
# browser login automatically.
#
# Values are the URL-encoded cookie values copied from your browser, e.g.:
#
# SWY_SHARED_SESSION='%7B%22accessToken%22%3A%22eyJraWQiOi...%22%2C%22refreshToken%22%3A%22...%22%2C%22issueTime%22%3A...%2C%22expireTime%22%3A...%7D'
# SWY_SHARED_SESSION_INFO='%7B%22info%22%3A%7B%22J4U%22%3A%7B%22storeId%22%3A%221983%22%7D%2C%22SHOP%22%3A%7B%22storeId%22%3A%221983%22%7D%7D%7D'
#
# Leave both unset/commented out to use normal browser login (recommended for
# scheduled/cron runs).
# SWY_SHARED_SESSION=
# SWY_SHARED_SESSION_INFO=
